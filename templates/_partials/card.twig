{% set component = {
  image: image ?? item.image.one() ?? null,
  headline: headline ?? item.headline ?? null,
  button: button ?? item.button ?? null,
  type: type ?? 'c-card'
} %}

<div class="{{component.type}}">
	<a href="{{ component.button.getUrl() }}" class="{{component.type}}__inner">
		{% if component.image|length %}
			{% set image = craft.imager.transformImage(component.image, {
        width: component.type == 'c-card--alt' ? 560 : 450,
        height: component.type == 'c-card--alt' ? 375 : 650,
        mode: 'crop',
        jpegQuality: 100
      }) %}
			<div class="{{component.type}}__image">
				<img src="{{ image ? image.url }}" alt="{{ component.headline }}">
			</div>
		{% endif %}
		<div class="{{component.type}}__content">
			{% if component.headline|length %}
				<h3 class="{{component.type}}__headline">{{ component.headline }}</h3>
			{% endif %}
			{% if component.button|length and component.button.getText()|length and component.type != 'c-card--alt' %}
				<div class="{{component.type}}__btn">
					<button type="button" class="btn btn--outlinedWhite">{{ component.button.getText() }}</button>
				</div>
			{% endif %}
		</div>
		{% if component.type == 'c-card--alt' %}
		<div class="{{component.type}}__arrow">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
				<mask id="mask0_2190_474" style="mask-type:alpha" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
					<rect width="24" height="24" fill="#D9D9D9"/>
				</mask>
				<g mask="url(#mask0_2190_474)">
					<path d="M12.9463 11.9999L8.34625 7.39994L9.4 6.34619L15.0538 11.9999L9.4 17.6537L8.34625 16.5999L12.9463 11.9999Z" fill="white" fill-opacity="0.8"/>
				</g>
			</svg>
		</div>
		{% endif %}
	</a>
</div>
