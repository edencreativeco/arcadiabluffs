{% set bannerAsset = entry is defined and entry.bannerImage | length ? entry.bannerImage.one() : null %}
{% set isVideo = bannerAsset and bannerAsset.kind == 'video' %}
{% set bannerUrl = not isVideo and bannerAsset ? (craft.imager.transformImage(bannerAsset, {
		width: 1680,
		height: 440,
		mode: 'crop',
		jpegQuality: 100,
		position: bannerAsset.getFocalPoint()
}).url) : null %}
{% set fallbackUrl = '/assets/img/banner.jpg' %}

<div class="banner banner__{{ template }}" style="{% if not isVideo %}background-image: url({{ bannerUrl ?? fallbackUrl }});{% endif %} position: relative; overflow: hidden;">
	{% if isVideo %}
		<video autoplay loop muted playsinline class="banner__video" style="width:100%;height:100%;object-fit:cover;position:absolute;top:0;left:0;z-index:1;">
			<source src="{{ bannerAsset.url }}" type="{{ bannerAsset.getMimeType() }}">
			Your browser does not support HTML5 video.
		</video>
	{% endif %}
	<div style="position:relative;z-index:2;width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;">
		{% if entry.headline is defined and entry.headline | length %}
			{% if template == 'accommodations-entry' %}
				{% set title = entry.title %}
			{% else %}
				{% set title = entry.headline %}
			{% endif %}
		{% endif %}
		{% if template == 'hole-entry' %}
			{% set url = craft.app.request.getSegment(1) %}
			{# <a href="/{{ url }}" class="banner__link">Back to Course</a>
			<h1 class="banner__headline">{{ entry.title }}</h1> #}
		{% else %}
			<h1 class="banner__headline">{{ title }}</h1>
		{% endif %}
	</div>
</div>
