{% import '_macros' as macros %}

<div class="nav">
	<div class="nav__logo">
		<a class="nav__logo-link" href="/">
			<span class="hide-visually">{{ siteName }}</span>
			{% include '_assets/logo.svg' %}
		</a>
	</div>
	{% set navItems = craft.entries()
	.section('mainNavigation')
	.level(1)
	.all() %}

	{% set currentUrl = craft.app.request.absoluteUrl %}

	<nav class="nav__wrapper" role="navigation" aria-label="Main Navigation">
		
		<ul class="nav__menu">
			{% for item in navItems %}
			{% set hasChildren = item.children|length %}
			{% set isActive =
				item.navigationLink.url == currentUrl
				or item.children|filter(c => c.navigationLink.url == currentUrl)|length
			%}
			

			<li class="
				{{ hasChildren ? 'has-children' }}
				{{ isActive ? 'is-active' }}
			">
				{{ item.navigationLink.link }}
				{% set parentImage = item.navigationImage.one() %}
				

				{% if hasChildren %}
				<ul class="submenu">
					{% if parentImage %}
						{% set navImage = craft.imager.transformImage(parentImage, { width: 400, mode: 'fit' }) %}
						<div class="submenu-image-wrap">
							<img class="submenu-image" src="{{ navImage.url }}" alt="{{ parentImage.title }}" data-submenu-image="parent">
						</div>
					{% endif %}
					<li class="js-submenu-back submenu-back" style="display:none;"><button type="button">Back</button></li>
					{% for child in item.children %}
					{% set childActive = child.navigationLink.url == currentUrl %}

					{% set image = child.navigationImage.one() %}

					<li class="{{ childActive ? 'is-active' }}" data-submenu-index="{{ loop.index }}">
						{{ child.navigationLink.link }}
						{% if image %}
							{% set navImage = craft.imager.transformImage(image, { width: 400, mode: 'fit' }) %}
							<div class="submenu-image-wrap">
								<img class="submenu-image" src="{{ navImage.url }}" alt="{{ image.title }}" data-submenu-image="{{ loop.index }}">
							</div>
						{% endif %}
					</li>
					{% endfor %}
				</ul>
				{% endif %}
			</li>
			{% endfor %}
		{% set navMenu = header.secondaryNavigation.all() %}
		{% if navMenu|length %}
			{% for link in navMenu %}
				{% if link.linkField.getUrl() %}
					<li class="nav__secondary-mobile">
						<a target="{{link.linkField.target}}" href="{{ link.linkField.getUrl() }}">{{ link.linkField.getText() }}</a>
					</li>
				{% endif %}
			{% endfor %}
		{% endif %}
		{% if header.navCta and header.navCta.getUrl() %}
			<li>
				<a class="btn" target="{{header.navCta.target}}" href="{{ header.navCta.getUrl() }}">{{ header.navCta.getText() }}</a>
			</li>
		{% endif %}
		</ul>
	</nav>


	<button class="nav__toggle js-menu-toggle">Menu</button>
	
</div>







