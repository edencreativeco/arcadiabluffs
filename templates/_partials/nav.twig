{% import '_macros' as macros %}

<div class="nav">
	<div class="nav__logo">
		<a class="nav__logo-link" href="/">
			<span class="hide-visually">{{ siteName }}</span>
			{% include '_assets/logo.svg' %}
		</a>
	</div>
	{% set navItems = craft.entries()
	.section('mainNavigation')
	.level(1)
	.all() %}

	{% set currentUrl = craft.app.request.absoluteUrl %}

	<nav>
		<ul class="nav__menu menu">
			{% for item in navItems %}
			{% set hasChildren = item.children|length %}
			{% set isActive =
				item.navigationLink.url == currentUrl
				or item.children|filter(c => c.navigationLink.url == currentUrl)|length
			%}
			

			<li class="
				{{ hasChildren ? 'has-children' }}
				{{ isActive ? 'is-active' }}
			">
				{{ item.navigationLink.link }}

				{% if hasChildren %}
				<ul class="submenu">
					{% for child in item.children %}
					{% set childActive = child.navigationLink.url == currentUrl %}

					{% set image = child.navigationImage.one() %}

					<li class="{{ childActive ? 'is-active' }}" data-submenu-index="{{ loop.index }}">
						{{ child.navigationLink.link }}
						{% if image %}
							{% set navImage = craft.imager.transformImage(image, { width: 200, mode: 'fit' }) %}
							<div class="submenu-image-wrap">
								<img class="submenu-image" src="{{ navImage.url }}" alt="{{ image.title }}" data-submenu-image="{{ loop.index }}">
							</div>
						{% endif %}
					</li>
					{% endfor %}
				</ul>
				{% endif %}
			</li>
			{% endfor %}
		</ul>
	</nav>

	<button class="nav__toggle js-nav-toggle">Menu</button>
</div>

<script>
// Only show the hovered submenu image
(function() {
  document.querySelectorAll('.submenu').forEach(function(submenu) {
    submenu.addEventListener('mouseover', function(e) {
      var li = e.target.closest('li[data-submenu-index]');
      if (!li) return;
      var idx = li.getAttribute('data-submenu-index');
      submenu.querySelectorAll('.submenu-image').forEach(function(img) {
        img.style.display = (img.getAttribute('data-submenu-image') === idx) ? 'block' : 'none';
      });
    });
    submenu.addEventListener('mouseleave', function() {
      submenu.querySelectorAll('.submenu-image').forEach(function(img) {
        img.style.display = 'none';
      });
    });
  });
})();
</script>



