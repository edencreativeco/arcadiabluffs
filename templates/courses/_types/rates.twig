{% extends '_layouts/default.twig' %}
{% set template = 'course-rates' %}

{% set title = entry.title %}
{% set home = 'false' %}
{% set id = entry.slug %}
{% set data_page = entry.slug %}

{% block body %}

	{% include '_partials/banner' %}

	{% include '_partials/subpage-menu' %}

	<main class="main main__{{ template }}" role="main">
    {% set rateEntries = craft.entries()
  .rateTable(':notempty:')
  .id('not ' ~ entry.id)
  .all()
%}

 <h1 class="rates__pricing-headline">{{ entry.ratesHeadline|length ? entry.ratesHeadline : 'Rates' }} </h1>

<section class="rates-table">
  <div class="rates-table__tabs-wrap">
    <ul class="rates-table__tabs tabs">
      {# Current entry tab #}
      {% if entry.rateTable.table|length %}
        <li class="rates-table__tab tab">
          <a href="#" data-tab="current" class="rates-table__link tabs__link active">{{ entry.parent.title ?? entry.title }}</a>
        </li>
      {% endif %}
      
      {# Other entries tabs #}
      {% for rateEntry in rateEntries %}
        <li class="rates-table__tab tab">
          <a href="#" data-tab="{{ loop.index }}" class="rates-table__link tabs__link">{{ rateEntry.parent.title ?? rateEntry.title }}</a>
        </li>
      {% endfor %}
    </ul>
    
    {# Current entry content #}
    {% if entry.rateTable.table|length %}
      <div data-content="current" class="tabs__content active">
        <table>
          <thead>
            <tr>
              {% for col in entry.rateTable.columns %}
                <th>
                  {{ col.heading }}
                </th>
              {% endfor %}
            </tr>
          </thead>

          <tbody>
            {% for row in entry.rateTable.rows %}
              <tr>
                {% for cell in row %}
                  <td >
                    {{ cell }}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% if entry.ratesFootnotes|length %}
          <ul class="rates-table__footnotes">
            {% for block in entry.ratesFootnotes.type('footnote') %}
              <li>{{ block.footnote }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
    
    {# Other entries content #}
    {% for rateEntry in rateEntries %}
      <div data-content="{{ loop.index }}" class="tabs__content">
        <table>
          <thead>
            <tr>
              {% for col in rateEntry.rateTable.columns %}
                <th>
                  {{ col.heading }}
                </th>
              {% endfor %}
            </tr>
          </thead>

          <tbody>
            {% for row in rateEntry.rateTable.rows %}
              <tr>
                {% for cell in row %}
                  <td>
                    {{ cell }}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% if rateEntry.ratesFootnotes|length %}
          <ul class="rates-table__footnotes">
            {% for block in rateEntry.ratesFootnotes.type('footnote') %}
              <li>{{ block.footnote }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>


   


		<section class="rates-list">
			{% for block in entry.ratesList %}
				<div class="rates-list__item">
					<h2 class="rates-list__headline">{{ block.headline }}</h2>
					<div class="rates-list__content">
						{{ block.body }}
					</div>
					{% if block.price | length %}
						<p class="rates-list__price">{{ block.price }}</p>
					{% endif %}
					{% if block.linkText or block.linkUrl | length %}
						<a class="cta-link" href="{{ block.linkUrl }}">{{ block.linkText }}</a>
					{% endif %}
				</div>
			{% endfor %}
		</section>

	</main>

{% endblock %}